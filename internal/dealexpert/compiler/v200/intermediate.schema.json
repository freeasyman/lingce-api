{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingce.local/schema/deal-analysis-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "input_snapshot_id",
    "conclusion",
    "decision",
    "clinical_risk",
    "contact_request",
    "product_findings",
    "proposed_action",
    "secondary_findings",
    "quality",
    "coach",
    "confidence",
    "unknowns"
  ],
  "properties": {
    "protocol_version": {
      "const": "deal-analysis-v2"
    },
    "input_snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "verification",
        "source_refs"
      ],
      "properties": {
        "summary": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "verification": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[sf][1-9][0-9]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "source_refs",
        "condition",
        "trust",
        "need",
        "concerns",
        "outcome_signals"
      ],
      "properties": {
        "state": {
          "enum": [
            "了解比较中",
            "有意向但未决定",
            "暂缓",
            "明确不考虑",
            "已预约",
            "已交定金",
            "已付款",
            "无法判断"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[sf][1-9][0-9]*$"
          },
          "uniqueItems": true
        },
        "condition": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "summary",
                "source_refs"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "source_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[sf][1-9][0-9]*$"
                  },
                  "uniqueItems": true
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "trust": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "target_label",
              "state",
              "summary",
              "source_refs"
            ],
            "properties": {
              "target": {
                "enum": [
                  "医生",
                  "机构",
                  "方案",
                  "承诺",
                  "其他"
                ]
              },
              "target_label": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "state": {
                "enum": [
                  "已建立",
                  "部分建立",
                  "存疑",
                  "无法判断"
                ]
              },
              "summary": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[sf][1-9][0-9]*$"
                },
                "uniqueItems": true
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "target": {
                      "const": "其他"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "target_label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 12
                    }
                  }
                },
                "else": {
                  "properties": {
                    "target_label": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        },
        "need": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "summary",
            "source_refs"
          ],
          "properties": {
            "state": {
              "enum": [
                "明确",
                "部分明确",
                "不清",
                "无法判断"
              ]
            },
            "summary": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[sf][1-9][0-9]*$"
              },
              "uniqueItems": true
            }
          }
        },
        "concerns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "type_label",
              "summary",
              "is_primary",
              "source_refs"
            ],
            "properties": {
              "type": {
                "enum": [
                  "效果与适配",
                  "安全与恢复",
                  "价格与价值",
                  "医生与机构信任",
                  "家属或共同决策人",
                  "时间与流程",
                  "竞品比较",
                  "疼痛隐私情绪",
                  "其他"
                ]
              },
              "type_label": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "is_primary": {
                "type": "boolean"
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[sf][1-9][0-9]*$"
                },
                "uniqueItems": true
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "其他"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "type_label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 12
                    }
                  }
                },
                "else": {
                  "properties": {
                    "type_label": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        },
        "outcome_signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "summary",
              "source_refs"
            ],
            "properties": {
              "type": {
                "enum": [
                  "预约",
                  "定金",
                  "付款",
                  "退款"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[sf][1-9][0-9]*$"
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "clinical_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment",
        "summary",
        "source_refs"
      ],
      "properties": {
        "assessment": {
          "enum": [
            "no_unresolved_issue_observed",
            "unresolved",
            "unknown"
          ]
        },
        "summary": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[sf][1-9][0-9]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "contact_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "summary",
        "source_refs"
      ],
      "properties": {
        "value": {
          "enum": [
            "no_restriction_observed",
            "stop",
            "unknown"
