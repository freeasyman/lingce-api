                },
                "source_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[sf][1-9][0-9]*$"
                  },
                  "uniqueItems": true
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "assessment": {
                        "const": "scored"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "score": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "score": {
                        "type": "null"
                      },
                      "highlight_narrative": {
                        "type": "null"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "score": {
                        "type": "integer",
                        "maximum": 3
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "highlight_narrative": {
                        "type": "null"
                      }
                    }
                  }
