          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[sf][1-9][0-9]*$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "proposed_action": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "goal",
            "action",
            "suggested_content",
            "due_basis",
            "timing_source_refs",
            "source_refs"
          ],
          "properties": {
            "type": {
              "enum": [
                "sales_follow_up",
                "internal_coordination",
                "internal_review"
              ]
            },
            "goal": {
              "type": "string",
              "minLength": 1
            },
            "action": {
              "type": "string",
              "minLength": 1
            },
            "suggested_content": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "due_basis": {
              "enum": [
                "today",
                "within_48h",
                "within_7d",
                "after_family_discussion",
                "after_clinical_confirmation",
                "unknown"
              ]
            },
            "timing_source_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[sf][1-9][0-9]*$"
              },
              "uniqueItems": true
            },
            "source_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[sf][1-9][0-9]*$"
              },
              "uniqueItems": true
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "secondary_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "summary",
          "source_refs"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[sf][1-9][0-9]*$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard_version",
        "dimensions"
      ],
      "properties": {
        "standard_version": {
          "const": "compass-sales-v1.1"
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
