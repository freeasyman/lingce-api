          "finding_type": {
            "enum": [
              "已正确推荐",
              "推荐不清",
              "可能漏推",
              "升级机会",
              "联合机会",
              "替代方案"
            ]
          },
          "customer_evidence_summary": {
            "type": "string",
            "minLength": 1
          },
          "matching_reason": {
            "type": "string",
            "minLength": 1
          },
          "recommended_by_consultant": {
            "type": "boolean"
          },
          "suggested_action": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
