      }
    },
    "product_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "catalog_product_id",
          "mentioned_name",
          "finding_type",
          "customer_evidence_summary",
          "matching_reason",
          "recommended_by_consultant",
          "suggested_action",
          "confidence",
          "source_refs"
        ],
        "properties": {
          "catalog_product_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "mentioned_name": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
