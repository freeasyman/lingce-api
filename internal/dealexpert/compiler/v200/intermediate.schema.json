              "properties": {
                "assessment": {
                  "enum": [
                    "scored",
                    "not_applicable",
                    "insufficient_evidence"
                  ]
                },
                "score": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 5
                    },
                    {
                      "type": "null"
