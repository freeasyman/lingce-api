  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "source_refs",
        "condition",
        "trust",
        "need",
        "concerns",
        "outcome_signals",
        "target",
        "confidence"
      ],
      "properties": {
        "state": {
          "enum": [
            "了解比较中",
            "有意向但未决定",
            "暂缓",
            "明确不考虑",
            "无法判断"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[sf][1-9][0-9]*$"
          },
          "uniqueItems": true
        },
        "condition": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
