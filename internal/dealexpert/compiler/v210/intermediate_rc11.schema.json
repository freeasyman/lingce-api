                  "承诺",
                  "其他"
                ]
              },
              "target_label": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "state": {
                "enum": [
                  "已建立",
                  "部分建立",
                  "存疑",
                  "无法判断"
                ]
