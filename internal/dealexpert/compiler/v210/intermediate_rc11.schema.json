            "summary": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[sf][1-9][0-9]*$"
              },
              "uniqueItems": true
            },
            "support": {
              "anyOf": [
                {
                  "$ref": "#/$defs/statementSupport"
                },
                {
                  "type": "null"
                }
              ]
            }
