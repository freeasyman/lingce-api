            "source_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^s[1-9][0-9]*$"
              },
              "uniqueItems": true
            },
            "customer_window_source_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^s[1-9][0-9]*$"
