                  "时间与流程",
                  "竞品比较",
                  "疼痛隐私情绪",
                  "其他"
                ]
              },
              "type_label": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "is_primary": {
                "type": "boolean"
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[sf][1-9][0-9]*$"
                },
                "uniqueItems": true
              },
              "support": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/statementSupport"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "其他"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "type_label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 12
                    }
                  }
                },
                "else": {
                  "properties": {
                    "type_label": {
                      "type": "null"
                    }
                  }
                }
              }
