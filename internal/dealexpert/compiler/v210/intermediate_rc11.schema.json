{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingce.local/schema/deal-analysis-v2.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "input_snapshot_id",
    "conclusion",
    "decision",
    "clinical_risk",
    "contact_request",
    "product_findings",
    "proposed_action",
    "secondary_findings",
    "quality",
    "coach",
    "confidence",
    "unknowns",
    "event_reports",
    "additional_decisions"
  ],
  "properties": {
    "protocol_version": {
      "const": "deal-analysis-v2.1"
    },
    "input_snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "verification",
        "source_refs"
      ],
      "properties": {
        "summary": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "verification": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[sf][1-9][0-9]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "clinical_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment",
        "summary",
        "source_refs"
      ],
      "properties": {
        "assessment": {
          "enum": [
            "no_unresolved_issue_observed",
            "unresolved",
            "unknown"
          ]
        },
        "summary": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[sf][1-9][0-9]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "contact_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "summary",
        "source_refs"
      ],
      "properties": {
        "value": {
          "enum": [
            "no_restriction_observed",
            "stop",
            "unknown"
          ]
        },
        "summary": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[sf][1-9][0-9]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "product_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "catalog_product_id",
          "mentioned_name",
          "finding_type",
          "customer_evidence_summary",
          "matching_reason",
          "recommended_by_consultant",
          "suggested_action",
          "confidence",
          "source_refs"
        ],
        "properties": {
          "catalog_product_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "mentioned_name": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "finding_type": {
            "enum": [
              "已正确推荐",
              "推荐不清",
              "可能漏推",
              "升级机会",
              "联合机会",
              "替代方案"
            ]
          },
          "customer_evidence_summary": {
            "type": "string",
            "minLength": 1
          },
          "matching_reason": {
            "type": "string",
            "minLength": 1
          },
          "recommended_by_consultant": {
            "type": "boolean"
          },
          "suggested_action": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[sf][1-9][0-9]*$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "proposed_action": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "template",
            "source_refs",
            "customer_window_source_refs"
          ],
          "properties": {
            "type": {
              "enum": [
                "sales_follow_up",
                "internal_coordination",
                "internal_review"
