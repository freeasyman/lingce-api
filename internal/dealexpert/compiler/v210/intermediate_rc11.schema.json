                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[sf][1-9][0-9]*$"
                },
                "uniqueItems": true
              },
              "support": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/statementSupport"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "target": {
                      "const": "其他"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "target_label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 12
                    }
                  }
                },
                "else": {
                  "properties": {
                    "target_label": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        },
        "need": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "summary",
            "source_refs"
          ],
          "properties": {
            "state": {
              "enum": [
                "明确",
                "部分明确",
                "不清",
                "无法判断"
              ]
