  },
  "allOf": [
    {
      "if": {
        "properties": {
          "confidence": {
            "const": "low"
          }
        }
      },
      "then": {
        "properties": {
          "primary_action": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "enum": [
                      "internal_coordination",
                      "internal_review"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "contact_policy": {
            "enum": [
              "review"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "primary_action": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "enum": [
                      "internal_coordination",
                      "internal_review"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "clinical_conflict": {
            "properties": {
