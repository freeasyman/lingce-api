{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingce.local/schema/deal-card-v2.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "conclusion",
    "decision",
    "clinical_conflict",
    "contact_policy",
    "product_findings",
    "primary_action",
    "secondary_findings",
    "evidence_refs",
    "quality",
    "coach",
    "confidence",
    "unknowns",
    "brief",
    "rules_version",
    "input_snapshot_id",
    "status",
    "contact_evidence_refs",
    "business_facts",
    "event_reports",
    "intent",
    "target_binding",
    "recording_observations",
    "scheme_decisions",
    "analysis_scope"
  ],
  "properties": {
    "schema_version": {
      "const": "deal-card-v2.1"
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_state",
        "business_impact",
        "main_basis",
        "verification"
      ],
      "properties": {
        "current_state": {
          "type": "string",
          "minLength": 1
        },
        "business_impact": {
          "enum": [
            "仍可推进",
            "已流失",
            "已成交可复盘",
            "无法判断"
          ]
        },
        "main_basis": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev_[0-9]+$"
          },
          "minItems": 0
        },
        "verification": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "clinical_conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "reason",
        "evidence_refs",
        "assessment"
      ],
      "properties": {
        "active": {
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev_[0-9]+$"
          },
          "minItems": 0
        },
        "assessment": {
          "enum": [
            "no_unresolved_issue_observed",
            "unresolved",
            "unknown"
          ]
        }
      }
    },
    "contact_policy": {
      "enum": [
        "allow",
        "stop",
        "pause_clinical",
        "review"
      ]
    },
    "product_findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/product"
      },
      "minItems": 0
    },
    "primary_action": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "template",
            "goal",
            "action",
            "suggested_content",
            "owner_employee_id",
            "due_basis",
            "due_provenance",
            "due_quote",
            "timing_evidence_refs",
            "source_evidence_refs",
            "customer_window"
          ],
          "properties": {
            "type": {
              "enum": [
                "sales_follow_up",
                "internal_coordination",
                "internal_review"
              ]
            },
            "template": {
              "enum": [
                "confirm_next_step",
                "professional_handoff",
                "review_sources"
              ]
            },
            "goal": {
              "type": "string",
              "minLength": 1
            },
            "action": {
              "type": "string",
              "minLength": 1
            },
            "suggested_content": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "owner_employee_id": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "due_basis": {
              "enum": [
                "within_48h"
              ]
            },
            "due_provenance": {
              "enum": [
                "system_suggestion"
              ]
            },
            "due_quote": {
              "type": "null"
            },
            "timing_evidence_refs": {
              "type": "array",
              "maxItems": 0
            },
            "source_evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^ev_[1-9][0-9]*$"
              },
              "uniqueItems": true
            },
            "customer_window": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "quote",
                    "evidence_refs"
                  ],
                  "properties": {
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence_refs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^ev_[1-9][0-9]*$"
                      },
                      "uniqueItems": true
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "secondary_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "summary",
          "evidence_refs"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ev_[0-9]+$"
            },
            "minItems": 0
          }
        }
      },
      "minItems": 0
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 0
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard_version",
        "dimensions"
      ],
      "properties": {
        "standard_version": {
          "const": "compass-sales-v1.1"
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "开场建立权威",
            "需求探索",
            "问题放大",
            "专业呈现",
            "方案定制",
            "异议化解",
            "促成与收尾"
          ],
          "properties": {
            "开场建立权威": {
              "$ref": "#/$defs/qualityItem"
            },
            "需求探索": {
              "$ref": "#/$defs/qualityItem"
            },
            "问题放大": {
              "$ref": "#/$defs/qualityItem"
            },
            "专业呈现": {
              "$ref": "#/$defs/qualityItem"
            },
            "方案定制": {
              "$ref": "#/$defs/qualityItem"
            },
            "异议化解": {
              "$ref": "#/$defs/qualityItem"
            },
            "促成与收尾": {
              "$ref": "#/$defs/qualityItem"
            }
          }
        }
      }
    },
    "coach": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observations",
        "improvement"
      ],
      "properties": {
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "behavior",
              "customer_response",
              "evidence_refs",
              "response_evidence_refs"
            ],
            "properties": {
              "behavior": {
                "type": "string",
                "minLength": 1
              },
              "customer_response": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^ev_[1-9][0-9]*$"
                },
                "uniqueItems": true
              },
              "response_evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^ev_[1-9][0-9]*$"
                },
                "uniqueItems": true
              }
            }
          }
        },
        "improvement": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "suggestion",
                "evidence_refs"
              ],
              "properties": {
                "suggestion": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^ev_[1-9][0-9]*$"
                  },
                  "uniqueItems": true
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "situation",
        "blocker",
        "next_step",
        "evidence_refs"
      ],
      "properties": {
        "situation": {
          "type": "string",
          "minLength": 1
        },
        "blocker": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 5,
              "maxLength": 70
            },
            {
              "type": "null"
            }
          ]
        },
        "next_step": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ev_[1-9][0-9]*$"
          }
        }
      }
    },
    "rules_version": {
      "const": "deal-compiler-v2.1.0-rc12"
    },
    "input_snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "analyzed",
        "needs_review"
      ]
    },
    "contact_evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ev_[1-9][0-9]*$"
      }
    },
    "business_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "summary",
          "source_record_id",
          "occurred_at",
          "evidence_refs"
        ],
        "properties": {
          "type": {
            "enum": [
              "预约",
              "定金",
              "付款",
              "退款"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "source_record_id": {
            "type": "integer",
            "minimum": 1
          },
          "occurred_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^ev_[1-9][0-9]*$"
            },
            "minItems": 1
          }
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "evidence_refs",
        "scope"
      ],
      "properties": {
        "state": {
          "enum": [
            "了解比较中",
            "有意向但未决定",
            "暂缓",
            "明确不考虑",
            "无法判断"
          ]
        },
        "target": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev_[1-9][0-9]*$"
          },
          "uniqueItems": true
        },
        "scope": {
          "const": "recording"
        }
      }
    },
    "event_reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_type",
          "state",
          "subject",
          "evidence_refs"
        ],
        "properties": {
          "event_type": {
            "enum": [
              "预约",
              "付款",
              "定金",
              "退款",
              "联系",
              "其他"
            ]
          },
          "state": {
            "enum": [
              "planned",
              "claimed_completed",
              "denied",
              "unknown"
            ]
          },
          "subject": {
            "enum": [
              "target_customer",
              "other_person",
              "unknown"
            ]
          },
          "verified_fact_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ev_[1-9][0-9]*$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "target_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "target_customer_id",
        "binding_record_id"
      ],
      "properties": {
        "state": {
          "enum": [
            "unresolved",
            "single_customer",
            "multiple_customers"
          ]
        },
        "target_customer_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "binding_record_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "recording_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "summary",
          "target",
          "subject_binding",
          "evidence_refs"
        ],
        "properties": {
          "kind": {
            "enum": [
              "intent",
              "condition",
              "need",
              "concern",
              "trust",
              "clinical_statement",
              "secondary",
              "staff_claim",
              "non_business",
              "timing",
              "willingness",
              "exam",
              "symptom",
              "question",
              "staff_statement"
            ]
          },
          "summary": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "target": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "subject_binding": {
            "enum": [
              "target_customer",
              "consultant",
              "other_person",
              "unresolved",
              "mixed"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ev_[1-9][0-9]*$"
            },
            "uniqueItems": true
          },
          "timing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "date"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "absolute_date",
                  "relative_window",
                  "sequence",
                  "unknown"
                ]
              },
              "date": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "scheme_decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      },
      "maxItems": 20,
      "minItems": 1
    },
    "analysis_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "evidence_refs"
      ],
      "properties": {
        "kind": {
          "enum": [
            "business",
            "non_business",
            "unclear"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev_[1-9][0-9]*$"
          },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_state",
        "state_basis",
        "evidence_refs",
        "condition",
        "condition_due_quote",
        "trust",
        "need_state",
        "need_summary",
        "need_evidence_refs",
        "concerns",
        "outcome_signals",
        "condition_evidence_refs",
        "condition_kind",
        "target",
        "confidence"
      ],
      "properties": {
        "decision_state": {
          "enum": [
            "了解比较中",
            "有意向但未决定",
            "暂缓",
            "明确不考虑",
            "无法判断"
          ]
        },
        "state_basis": {
          "enum": [
            "transcript_judgment",
            "unknown"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev_[0-9]+$"
          },
          "minItems": 0
        },
        "condition": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "condition_due_quote": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "trust": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trust_target",
              "state",
              "summary",
              "evidence_refs"
            ],
            "properties": {
              "trust_target": {
                "enum": [
                  "医生",
                  "机构",
                  "方案",
                  "承诺",
                  "其他"
                ]
              },
              "state": {
                "enum": [
                  "已建立",
                  "部分建立",
                  "存疑",
                  "无法判断"
                ]
              },
              "summary": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^ev_[0-9]+$"
                },
                "minItems": 0
              },
              "target_label": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "trust_target": {
                      "const": "其他"
                    }
                  }
                },
                "then": {
                  "required": [
                    "target_label"
                  ],
                  "properties": {
                    "target_label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 12
                    }
                  }
                }
              }
            ]
          },
          "minItems": 0
        },
        "need_state": {
          "enum": [
            "明确",
            "部分明确",
            "不清",
            "无法判断"
          ]
        },
        "need_summary": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "need_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev_[0-9]+$"
          },
          "minItems": 0
        },
        "concerns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "summary",
              "is_primary",
              "evidence_refs"
            ],
            "properties": {
              "type": {
                "enum": [
                  "效果与适配",
                  "安全与恢复",
                  "价格与价值",
                  "医生与机构信任",
                  "家属或共同决策人",
                  "时间与流程",
                  "竞品比较",
                  "疼痛隐私情绪",
                  "其他"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "is_primary": {
                "type": "boolean"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^ev_[0-9]+$"
                },
                "minItems": 1
              },
              "type_label": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "其他"
                    }
                  }
                },
                "then": {
                  "required": [
                    "type_label"
                  ],
                  "properties": {
                    "type_label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 12
                    }
                  }
                }
              }
            ]
          },
          "minItems": 0
        },
        "outcome_signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "summary",
              "evidence_refs"
            ],
            "properties": {
              "type": {
                "enum": [
                  "预约",
                  "定金",
                  "付款",
                  "退款"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^ev_[0-9]+$"
                },
                "minItems": 1
              }
            }
          },
          "minItems": 0,
          "maxItems": 0
        },
        "condition_evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ev_[1-9][0-9]*$"
          }
        },
        "condition_kind": {
          "anyOf": [
            {
              "enum": [
                "family_discussion",
                "clinical_confirmation",
                "customer_window",
                "practical_constraint",
                "other"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "scope"
          ],
          "properties": {
            "level": {
              "enum": [
                "high",
                "medium",
                "low",
                "unknown"
              ]
            },
            "scope": {
              "const": "scheme"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision_state": {
                "const": "暂缓"
              }
            }
          },
          "then": {
            "properties": {
              "condition": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^ev_[0-9]+$"
                },
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "condition": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "condition_due_quote": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "qualityItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment",
        "score",
        "comment",
        "evidence_refs",
        "impact_on_deal",
        "highlight_narrative"
      ],
      "properties": {
        "assessment": {
          "enum": [
            "scored",
            "not_applicable",
            "insufficient_evidence"
          ]
        },
        "score": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            {
              "type": "null"
            }
          ]
        },
        "comment": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev_[0-9]+$"
          },
          "minItems": 0
        },
        "impact_on_deal": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "highlight_narrative": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assessment": {
                "const": "scored"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^ev_[0-9]+$"
                },
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "score": {
                "type": "null"
              },
              "highlight_narrative": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "score": {
                "type": "integer",
                "maximum": 3
              }
            }
          },
          "then": {
            "properties": {
              "highlight_narrative": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
