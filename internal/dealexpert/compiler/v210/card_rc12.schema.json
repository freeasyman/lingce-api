                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "contact_policy": {
            "enum": [
              "stop",
              "pause_clinical"
            ]
          },
          "product_findings": {
            "maxItems": 0
          },
          "primary_action": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "enum": [
                      "internal_coordination",
                      "internal_review"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "contact_policy": {
            "const": "stop"
          }
        }
      },
      "then": {
        "properties": {
          "primary_action": {
            "type": "null"
          }
        }
      }
    }
